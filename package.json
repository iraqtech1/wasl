{
  "name": "wasel-platform",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node tools/build.mjs",
    "build:pages": "node tools/build.mjs --pages",
    "prestart": "node tools/build.mjs",
    "start": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test vue-tests.cjs frontend-tests.cjs notification-tests.cjs phone-tests.cjs workflow-tests.cjs qr-tests.cjs",
